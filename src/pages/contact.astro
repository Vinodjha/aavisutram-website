---
import Layout from '../layouts/Layout.astro';
import contact from '../data/contact.json';

const { whatsappNumber, instagramHandle, email } = contact;
---
<Layout title="Contact" description="Get in touch with Aavisutram about an order or a question.">
  <section class="section container" style="max-width: 640px;">
    <h1 class="section-title">Get in touch</h1>
    <p class="section-subtitle">
      The quickest way to ask about a piece, a custom order, or shipping is WhatsApp — Instagram
      and email work too.
    </p>

    <div style="display:flex; flex-direction:column; gap:1rem; margin-top:1.5rem;">
      <a class="btn" href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">
        Message on WhatsApp
      </a>
      <a class="btn btn-outline" href={`https://instagram.com/${instagramHandle}`} target="_blank" rel="noopener noreferrer">
        Message on Instagram
      </a>
    </div>

    <p style="margin-top:1.5rem; text-align:center;">
      Or email directly:
      <br />
      <strong style="font-size:1.1rem; user-select:all;">{email}</strong>
      <br />
      <a href={`mailto:${email}`} style="font-size:0.85rem; color:var(--color-muted);">
        (click here to open it in your email app)
      </a>
    </p>

    <p style="margin-top:2rem; color:var(--color-muted);">
      Based in Denmark, currently shipping to Denmark and India — shipping cost and timeline are
      confirmed with you once an order is agreed.
    </p>
  </section>
</Layout>
